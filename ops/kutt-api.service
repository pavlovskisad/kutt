# /etc/systemd/system/kutt-api.service — installed by ops/bootstrap.sh

[Unit]
Description=KUTT Clip API
After=network.target mediamtx.service
Wants=mediamtx.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kutt/api
ExecStart=/usr/bin/node /opt/kutt/api/server.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
